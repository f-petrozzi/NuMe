# NüMe — environment variables
# Copy to apps/api/.env and fill in values

DATABASE_URL=postgresql+asyncpg://nume:nume@localhost:5432/nume
NUME_BIND_IP=127.0.0.1

# Clerk auth
# Local dev:
#   CLERK_AUTHORIZED_PARTIES=http://localhost:8080
# Production example:
#   CLERK_AUTHORIZED_PARTIES=https://nume-demo.com,https://www.nume-demo.com
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_FRONTEND_API_URL=
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=http://localhost:8080

# Azure OpenAI
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# Optional OpenAI-compatible aliases if you prefer the unified v1 names
# OPENAI_API_KEY=your-azure-openai-api-key-here
# OPENAI_BASE_URL=https://your-resource-name.openai.azure.com/openai/v1/
# OPENAI_MODEL=gpt-4.1-mini

# Garmin (optional — app works in manual mode without this)
GARMIN_ENABLED=false
GARMIN_USERNAME=your-garmin-email@example.com
GARMIN_PASSWORD=your-garmin-password
GARMIN_TOKEN_DIR=./garmin_tokens
GARMIN_SYNC_INTERVAL_MIN=45
GARMIN_SYNC_DAYS_BACK=30

# Share this with teammates once backend is running
API_BASE_URL=http://localhost:8000

# Frontend build/runtime values
# Local dev:
#   VITE_API_URL=http://localhost:8000
# Cloudflare Pages production:
#   VITE_API_URL=https://api.nume-demo.com
VITE_API_URL=http://localhost:8000
VITE_USE_MOCK_API=false

# Frontend auth (injected into the Vite app through Doppler / Pages)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Backend auth validation for the public frontend origin
# Example production value:
#   CLERK_AUTHORIZED_PARTIES=https://nume-demo.com,https://www.nume-demo.com
